                <h3 className="text-2xl font-bold text-red-900 mb-2">Caregiver Notified</h3>
                <p className="text-lg text-red-800 leading-relaxed">
                  We sent a text to <strong>{caregiver.name || 'Emergency Contact'}</strong> just to be safe.
                </p>
              </div>
              
              <div className="bg-white p-4 rounded-xl border border-red-100 text-left shadow-sm relative overflow-hidden">
                <div className="absolute left-0 top-0 bottom-0 w-1 bg-red-400"></div>
