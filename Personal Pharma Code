// --- MAIN APP COMPONENT ---
export default function App() {
  const [view, setView] = useState('onboarding'); 
  const [userProfile, setUserProfile] = useState({ name: '', ageRange: '', audioPref: true, largeText: true });
  const [caregiver, setCaregiver] = useState({ name: '', phone: '', relation: '' });
  const [medications, setMedications] = useState([]);
  
  // Clock & Alert Logic
  const [simTime, setSimTime] = useState(new Date(new Date().setHours(7, 0, 0, 0)));
  const [activeAlertMed, setActiveAlertMed] = useState(null); 

  const updateMedStatus = (medId, status) => {
    const dateKey = simTime.toDateString(); 
    setMedications(prev => prev.map(m => {
        if (m.id === medId) {
            return { 
                ...m, 
                status: status, 
                history: { ...m.history, [dateKey]: status }
            };
        }
        return m;
    }));
  };
  
  const textSize = userProfile.largeText ? 'text-lg' : 'text-base';
  const headingSize = userProfile.largeText ? 'text-3xl' : 'text-2xl';
  const buttonSize = userProfile.largeText ? 'py-4 text-xl' : 'py-3 text-lg';

  const speak = (text) => {
    if (userProfile.audioPref && 'speechSynthesis' in window) {
      window.speechSynthesis.cancel(); 
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.rate = 0.9; 
      window.speechSynthesis.speak(utterance);
    }
  };

  // --- CLOCK TICKER ---
  useEffect(() => {
    if (view === 'dashboard' && medications.length > 0 && !activeAlertMed) {
      const interval = setInterval(() => {
        setSimTime(prevTime => {
          const nextTime = new Date(prevTime.getTime() + 2 * 60000); // Add 2 simulated minutes
          
          // DAY ROLLOVER LOGIC: If hour >= 19 (7 PM), jump to next day 7 AM
          if (nextTime.getHours() >= 19) {
             const tomorrow = new Date(nextTime);
             tomorrow.setDate(tomorrow.getDate() + 1);
             tomorrow.setHours(7, 0, 0, 0);
             
             // SAVE YESTERDAY'S STATUS TO HISTORY BEFORE RESETTING
             const yesterdayKey = nextTime.toDateString();
             setMedications(currentMeds => currentMeds.map(m => {
                 // If status was 'pending' when day rolled over, mark as 'missed' in history
                 const finalStatus = m.status === 'pending' ? 'missed' : m.status;
                 return {
                     ...m,
                     status: 'pending',
                     history: { ...m.history, [yesterdayKey]: finalStatus }
                 };
             }));
             
             return tomorrow;
          }
          return nextTime;
        });
      }, 1000); 
      return () => clearInterval(interval);
    }
  }, [view, medications.length, activeAlertMed]);


  // --- TRIGGER CHECKER ---
  useEffect(() => {
    if (view === 'dashboard' && medications.length > 0 && !activeAlertMed) {
       const currentHour = simTime.getHours();
       const currentMinute = simTime.getMinutes();
       
       const medToTrigger = medications.find(m => {
          // Check stop date first
          if (m.stoppedDate) {
             const stop = new Date(m.stoppedDate);
             if (simTime > stop) return false;
          }
          
          // Check skipped dates
          const dateKey = simTime.toDateString();
          if (m.skippedDates && m.skippedDates[dateKey]) return false;

          const isTime = m.status === 'pending' && 
                         m.triggerHour === currentHour && 
                         currentMinute >= 0 && currentMinute < 15;
                         
          if (!isTime) return false;
          
          if (m.frequency === 'Daily') return true;
          if (m.frequency === 'Every other day') {
             const start = new Date(new Date(m.startDate).setHours(0,0,0,0));
             const curr = new Date(simTime);
             curr.setHours(0,0,0,0);
             const diff = Math.ceil(Math.abs(curr - start) / (1000 * 60 * 60 * 24));
             return diff % 2 === 0;
          }
          return true;
       });

       if (medToTrigger) {
         setActiveAlertMed(medToTrigger);
         speak(`It is time to take your ${medToTrigger.name}.`);
       }
    }
  }, [simTime, medications, view, activeAlertMed]);

  return (
    <div className="h-screen w-full bg-slate-100 flex items-center justify-center font-sans antialiased text-slate-900">
      <div className="w-full h-full max-w-[480px] bg-white sm:h-[850px] sm:rounded-3xl sm:shadow-2xl overflow-hidden relative border border-slate-200">
        
        {view === 'onboarding' && (
          <Onboarding 
            userProfile={userProfile} setUserProfile={setUserProfile} 
            setView={setView} speak={speak}
            headingSize={headingSize} textSize={textSize} buttonSize={buttonSize}
          />
        )}
        {view === 'caregiver' && (
          <CaregiverSetup 
            caregiver={caregiver} setCaregiver={setCaregiver} 
            setView={setView} 
            headingSize={headingSize} textSize={textSize} buttonSize={buttonSize}
          />
        )}
        {view === 'dashboard' && (
          <Dashboard 
            userProfile={userProfile} medications={medications} setMedications={setMedications}
            setView={setView} simTime={simTime}
            headingSize={headingSize} textSize={textSize} buttonSize={buttonSize}
          />
        )}
        {view === 'settings' && (
          <SettingsView 
            userProfile={userProfile} setUserProfile={setUserProfile} 
            caregiver={caregiver} setCaregiver={setCaregiver}
            setView={setView} 
            headingSize={headingSize} textSize={textSize} buttonSize={buttonSize}
          />
        )}
        {view === 'add-med' && (
          <AddMedication 
            medications={medications} setMedications={setMedications} 
            setView={setView} speak={speak}
            headingSize={headingSize} buttonSize={buttonSize}
          />
        )}

        {activeAlertMed && (
          <ActiveAlertOverlay 
             activeAlertMed={activeAlertMed} 
             setActiveAlertMed={setActiveAlertMed}
             updateMedStatus={updateMedStatus}
             caregiver={caregiver}
             speak={speak}
             userProfile={userProfile}
          />
        )}

      </div>
    </div>
  );
}