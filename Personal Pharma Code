      } else if (medications.length <= 3) {
        // 3rd: Iron (Every other day, Twice Daily)
        scanned = {
          id: Date.now(),
          name: 'Iron Supplement',
          dosage: '65mg',
          time: '9:00 AM & 6:00 PM', // Display purpose
          frequency: 'Every other day',
          duration: '60 days',
          startDate: today,
          
          isTwiceDaily: true,
          times: [
            { time: '9:00 AM', hour: 9 },
            { time: '6:00 PM', hour: 18 } 
          ]
        };
        speak("Label found. Iron Supplement, twice daily.");
      } else {
        // 4th: Lisinopril (Daily, 9 AM - overlaps with Iron)
        scanned = {
          id: Date.now(),
          name: 'Lisinopril',
          dosage: '10mg',
          time: '9:00 AM',
          triggerHour: 9,
          frequency: 'Daily',
          duration: '90 days',
          status: 'pending',
          history: {},
          skippedDates: {},
          stoppedDate: null,
          startDate: today
        };
        speak("Label found. Lisinopril.");
      }
      
      setFormData(scanned);
      setStep('review');
    }, 2500); 
  };

  const handleSave = () => {
    if (formData.isTwiceDaily) {
      const entry1 = {
        ...formData,
        id: Date.now(),
        time: formData.times[0].time,
        triggerHour: formData.times[0].hour,
        status: 'pending',
        history: {},
        skippedDates: {},
        stoppedDate: null
      };
      const entry2 = {
        ...formData,
        id: Date.now() + 1,
        time: formData.times[1].time,
        triggerHour: formData.times[1].hour,
        status: 'pending',
        history: {},
        skippedDates: {},
        stoppedDate: null
      };
      setMedications([...medications, entry1, entry2]);
    } else {
      setMedications([...medications, formData]);
    }
    setStep('success');
  };

  const resetFlow = () => {
    setStep('scan');
    setFormData(null);
  };

  if (step === 'scan') {
    return (
      <div className="flex flex-col h-full bg-slate-900 text-white relative">
        <div className="absolute top-0 w-full p-4 flex justify-between items-center z-20">
            <button onClick={() => setView('dashboard')} className="p-2 bg-black/40 rounded-full backdrop-blur-md">
                <X size={24} />
            </button>
            <span className="font-bold text-lg">Scan Bottle</span>
            <div className="w-10"></div> 
        </div>

        <div className="flex-1 flex flex-col items-center justify-center relative">
          {scanning ? (
            <div className="absolute inset-0 bg-black flex flex-col items-center justify-center">
                <div className="w-64 h-64 border-2 border-blue-500 rounded-2xl relative animate-pulse flex items-center justify-center">
                  <div className="absolute w-full h-1 bg-blue-500 top-0 animate-[scan_2s_infinite]"></div>
                  <span className="text-blue-400 font-mono font-bold bg-black/50 px-2 rounded">AI PROCESSING...</span>
                </div>
                <p className="mt-8 text-blue-300 font-medium">Extracting Dosage & Times...</p>
            </div>
          ) : (
            <div className="flex flex-col items-center w-full h-full justify-center bg-slate-800">
                <div className="w-64 h-64 border-2 border-white/30 rounded-2xl mb-8 flex items-center justify-center">
                  <p className="text-white/50 text-sm">Align Label Here</p>
                </div>
                <button 
                  onClick={handleScan}
                  className="h-20 w-20 bg-white rounded-full border-4 border-slate-300 flex items-center justify-center shadow-2xl hover:scale-105 transition"
                >
                  <div className="h-16 w-16 bg-white border-2 border-black rounded-full"></div>
                </button>
                <p className="mt-6 text-white/60 font-medium">Tap to capture</p>
            </div>
          )}
        </div>
      </div>
    );
  }

  if (step === 'review') {
    return (
      <div className="flex flex-col h-full bg-slate-50 text-slate-900 animate-in slide-in-from-bottom duration-500">
        <div className="p-6 pt-12 flex-1 overflow-y-auto">
          <div className="bg-green-100 p-4 rounded-xl border border-green-200 flex items-center gap-3 mb-6">
              <CheckCircle className="text-green-700" size={28} />
              <div>
                  <h3 className="font-bold text-green-900">Label Scanned</h3>
                  <p className="text-green-800 text-sm">Details extracted automatically.</p>
              </div>
          </div>

          <div className="bg-white p-6 rounded-2xl shadow-sm border border-slate-100 space-y-6">
              <div className="space-y-1">
                  <label className="text-xs font-bold text-slate-400 uppercase tracking-wider">Medication Name</label>
                  <p className="text-3xl font-bold text-slate-900">{formData.name}</p>
              </div>
              <div className="flex gap-4">
                  <div className="flex-1 space-y-1">
                      <label className="text-xs font-bold text-slate-400 uppercase tracking-wider">Dosage</label>
                      <p className="text-xl font-bold text-slate-800">{formData.dosage}</p>
                  </div>
                  <div className="flex-1 space-y-1">
                      <label className="text-xs font-bold text-slate-400 uppercase tracking-wider">Duration</label>
                      <p className="text-xl font-bold text-slate-800">{formData.duration}</p>
                  </div>
              </div>
              
              <div className="flex gap-4">
                  <div className="flex-1 space-y-1">
                      <label className="text-xs font-bold text-slate-400 uppercase tracking-wider">Time</label>
                      <p className="text-xl font-bold text-slate-800">{formData.time}</p>
                  </div>
                   <div className="flex-1 space-y-1">
                      <label className="text-xs font-bold text-slate-400 uppercase tracking-wider">Frequency</label>
                      <p className="text-xl font-bold text-slate-800">{formData.frequency}</p>
                  </div>
              </div>

              <div className="p-4 bg-blue-50 rounded-xl border border-blue-100">
                  <label className="text-xs font-bold text-blue-500 uppercase tracking-wider mb-1 block">AI Simplified Instructions</label>
                  <p className="text-lg font-medium text-blue-900 leading-relaxed">
                    "Take {formData.name} {formData.frequency.toLowerCase()} at {formData.time}."
                  </p>
              </div>
          </div>
        </div>
        
        <div className="p-6 bg-white border-t border-slate-100 space-y-3">
          <button 
            onClick={handleSave}
            className={`w-full bg-blue-600 text-white font-bold rounded-xl shadow-lg ${buttonSize}`}
          >
            Add to Schedule
          </button>
          
          <button 
            onClick={resetFlow}
            className={`w-full bg-slate-100 text-slate-600 font-bold rounded-xl ${buttonSize}`}
          >
            Cancel / Retake
          </button>
        </div>
      </div>
    );
  }

  if (step === 'success') {
    return (
      <div className="flex flex-col h-full bg-slate-50 text-slate-900 animate-in zoom-in duration-300 items-center justify-center p-6 text-center">
        <div className="w-24 h-24 bg-green-100 rounded-full flex items-center justify-center text-green-600 mb-6 shadow-inner">
           <CheckCircle size={48} />
        </div>
        <h2 className={`${headingSize} font-bold text-slate-900 mb-2`}>Medication Added!</h2>
        <p className="text-slate-600 mb-8 max-w-xs">{formData.name} has been added to your schedule.</p>

        <div className="w-full space-y-4 max-w-sm">
           <button 
              onClick={resetFlow}
              className={`w-full bg-white border-2 border-blue-600 text-blue-700 font-bold rounded-xl ${buttonSize} flex items-center justify-center gap-2`}
            >
              <Plus size={24} /> Add Another
           </button>

           <button 
              onClick={() => setView('dashboard')}
              className={`w-full bg-blue-600 text-white font-bold rounded-xl shadow-lg ${buttonSize}`}
            >
              Finish & View Schedule
           </button>
        </div>
      </div>
    );
  }
};

// 6. AUTOMATED ALERT OVERLAY
const ActiveAlertOverlay = ({ activeAlertMed, setActiveAlertMed, updateMedStatus, caregiver, speak, userProfile }) => {
  const [stage, setStage] = useState('banner1'); 

  useEffect(() => {
    let timer;
    if (stage === 'banner1') {
      timer = setTimeout(() => {
        setStage('banner2');
        speak(`Reminder. You have not confirmed your ${activeAlertMed.name}. Please take it now.`);
      }, 10000); 
    } else if (stage === 'banner2') {
      timer = setTimeout(() => {
        setStage('caregiver');
        speak(`Alerting ${caregiver.name || 'Caregiver'} that you may have missed a dose.`);
        updateMedStatus(activeAlertMed.id, 'missed'); 
      }, 10000); 
    }
    return () => clearTimeout(timer);
  }, [stage, activeAlertMed]);

  const handleTaken = () => {
    speak("Great job. Dose confirmed.");
    updateMedStatus(activeAlertMed.id, 'taken');
    setActiveAlertMed(null); 
  };

  const handleDismiss = () => {
    setActiveAlertMed(null); 
  };

  return (
    <div className="absolute inset-0 z-50 flex items-center justify-center p-6 bg-slate-900/80 backdrop-blur-sm animate-in fade-in duration-300">
        {/* STATE 1: GENTLE REMINDER */}
        {stage === 'banner1' && (
          <div className="w-full max-w-md bg-white rounded-3xl shadow-2xl overflow-hidden border-t-8 border-blue-500 animate-in zoom-in duration-300">
            <div className="bg-blue-50 p-6 flex flex-col items-center text-center gap-2 border-b border-blue-100">
              <div className="p-3 bg-blue-100 text-blue-600 rounded-full mb-2">
                  <Clock size={32} />
              </div>
              <span className="font-bold text-xl text-blue-900">Medication Time</span>
              <p className="text-blue-700">{activeAlertMed.time} Scheduled Dose</p>
            </div>
            <div className="p-8 text-center space-y-6">
              <div>
                  <p className="text-3xl font-bold text-slate-800 mb-1">{activeAlertMed.name}</p>
                  <p className="text-xl text-slate-500">Take 1 pill</p>
              </div>
              <button 
                  onClick={handleTaken} 
                  className="w-full bg-blue-600 hover:bg-blue-700 text-white py-4 rounded-2xl text-xl font-bold shadow-lg shadow-blue-200 transition-all transform active:scale-95"
              >
                Mark as Taken
              </button>
            </div>
            <div className="bg-slate-50 p-2 text-center text-xs text-slate-400">
                Gentle Reminder...
            </div>
          </div>
        )}

        {/* STATE 2: URGENT REMINDER */}
        {stage === 'banner2' && (
          <div className="w-full max-w-md bg-white rounded-3xl shadow-2xl overflow-hidden border-4 border-orange-500 animate-[pulse_2s_infinite]">
            <div className="bg-orange-500 p-4 text-white flex items-center justify-center gap-3">
              <AlertTriangle size={28} className="animate-bounce" />
              <span className="font-bold text-xl uppercase tracking-wider">Second Reminder</span>
            </div>
            <div className="p-8 text-center space-y-6">
              <div>
                  <p className="text-3xl font-bold text-slate-900 mb-2">{activeAlertMed.name}</p>
                  <p className="text-lg text-orange-600 font-bold bg-orange-50 p-3 rounded-lg border border-orange-100">
                      Please confirm you took this.
                  </p>
              </div>
              <button 
                  onClick={handleTaken} 
                  className="w-full bg-orange-600 hover:bg-orange-700 text-white py-4 rounded-2xl text-xl font-bold shadow-lg transition-all transform active:scale-95"
              >
                Mark as Taken
              </button>
            </div>
            <div className="bg-orange-50 p-2 text-center text-xs text-orange-400 font-bold">
                NOTIFYING CAREGIVER IN 10s...
            </div>
          </div>
        )}

         {/* STATE 3: CAREGIVER ALERT */}
         {stage === 'caregiver' && (
          <div className="w-full max-w-md bg-red-50 rounded-3xl shadow-2xl overflow-hidden border-2 border-red-200 animate-in slide-in-from-top duration-500">
            <div className="p-8 text-center space-y-6">
              <div className="w-24 h-24 bg-red-100 rounded-full mx-auto flex items-center justify-center text-red-600 mb-2 shadow-inner">
