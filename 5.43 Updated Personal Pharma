// --- HELPER FUNCTIONS ---
const generateCalendarDays = (baseDate) => {
  const dates = [];
  const start = new Date(baseDate);
  start.setDate(baseDate.getDate() - 2); 
  
  for (let i = 0; i < 5; i++) {
    const d = new Date(start);
    d.setDate(start.getDate() + i);
    dates.push(d);
  }
  return dates;
};

const isSameDay = (d1, d2) => {
  if (!d1 || !d2) return false;
  return d1.getDate() === d2.getDate() && 
         d1.getMonth() === d2.getMonth() && 
         d1.getFullYear() === d2.getFullYear();
};

const getDayName = (date, todayRef) => {
  if (isSameDay(date, todayRef)) return 'Today';
  const tomorrow = new Date(todayRef);
  tomorrow.setDate(todayRef.getDate() + 1);
  if (isSameDay(date, tomorrow)) return 'Tom';
  const yesterday = new Date(todayRef);
  yesterday.setDate(todayRef.getDate() - 1);
  if (isSameDay(date, yesterday)) return 'Yest';
  
  return date.toLocaleDateString('en-US', { weekday: 'short' });
};

