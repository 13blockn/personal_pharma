// 4. MAIN DASHBOARD
const Dashboard = ({ userProfile, medications, setMedications, setView, simTime, headingSize, textSize, buttonSize }) => {
  const [selectedDate, setSelectedDate] = useState(null);
  const [medToDelete, setMedToDelete] = useState(null); 
  // warningModal now stores flags for both types of warnings
  const [warningModal, setWarningModal] = useState(null); // { med: object, timeWarning: boolean, foodWarning: boolean }
  const [isFoodConfirmed, setIsFoodConfirmed] = useState(false);

  // Initialize selectedDate on mount
  useEffect(() => {
    if (!selectedDate) setSelectedDate(simTime);
  }, []); 

  useEffect(() => {
     if (selectedDate && isSameDay(selectedDate, new Date(simTime.getTime() - 86400000))) {
         // Auto-follow logic placeholder
     }
  }, [simTime]);

  const displayDate = selectedDate || simTime;
  const calendarDays = generateCalendarDays(simTime);

  // --- NEW: Unified Check for Marking Taken ---
  const initiateTakeMed = (med) => {
    // 1. Check Time (Early Warning)
    const scheduledTime = new Date(simTime);
    scheduledTime.setHours(med.triggerHour, 0, 0, 0);

    const diffMs = scheduledTime - simTime;
    const diffMins = diffMs / (1000 * 60);
    const isEarly = diffMins > 30;

    // 2. Check Food Requirement
    const needsFood = med.requiresFood;

    // If either condition is true, open the unified modal
    if (isEarly || needsFood) {
      setIsFoodConfirmed(false); // Reset confirmation state
      setWarningModal({ 
        med, 
        timeWarning: isEarly, 
        foodWarning: needsFood 
      });
    } else {
      // If no warnings, proceed directly
      finalizeTakeMed(med);
    }
  };

  const finalizeTakeMed = (med) => {
    const dateKey = displayDate.toDateString();
    setMedications(prev => prev.map(m => {
        if (m.id === med.id) {
            const isToday = isSameDay(displayDate, simTime);
            return { 
                ...m, 
                status: isToday ? 'taken' : m.status,
                history: { ...m.history, [dateKey]: 'taken' }
            };
        }
        return m;
    }));
    setWarningModal(null);
  };

  // --- Deletion Logic ---
  const handleDeleteSingle = () => {
    if (medToDelete) {
      const dateKey = displayDate.toDateString();
      setMedications(prev => prev.map(m => {
        if (m.id === medToDelete.id) {
           return {
             ...m,
             skippedDates: { ...m.skippedDates, [dateKey]: true }
           }
        }
        return m;
      }));
      setMedToDelete(null);
    }
  };

  const handleDeleteAll = () => {
    if (medToDelete) {
      setMedications(prev => prev.map(m => {
        if (m.name === medToDelete.name) {
           return { ...m, stoppedDate: simTime }; 
        }
        return m;
      }));
      setMedToDelete(null);
    }
  };

  const getStatusIcon = (status, isFuture) => {
    if (isFuture) return <Clock className="text-slate-400" size={20} />;
    switch(status) {
      case 'taken': return <CheckCircle className="text-white" size={20} />;
      case 'missed': return <AlertTriangle className="text-white" size={20} />;
      default: return <Clock className="text-blue-600" size={20} />;
    }
  };

  const getStatusColor = (status, isFuture) => {
    if (isFuture) return 'bg-slate-100 border-2 border-slate-200';
    switch(status) {
      case 'taken': return 'bg-green-500';
      case 'missed': return 'bg-red-500';
      default: return 'bg-blue-100';
    }
  };

  const filteredMedications = medications.filter(med => {
    if (med.stoppedDate) {
       const stop = new Date(med.stoppedDate);
       stop.setHours(0,0,0,0);
       const current = new Date(displayDate);
       current.setHours(0,0,0,0);
       if (current > stop) return false;
    }
    const dateKey = displayDate.toDateString();
    if (med.skippedDates && med.skippedDates[dateKey]) return false;

    if (med.frequency === 'Daily') return true;
    
    if (med.frequency === 'Every other day') {
      const startDate = new Date(med.startDate); 
      const start = new Date(startDate.setHours(0,0,0,0));
      const current = new Date(displayDate.getTime());
      current.setHours(0,0,0,0);
      const diffTime = Math.abs(current - start);
      const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
      return diffDays % 2 === 0;
    }
    return true;
  });

  const sortedMeds = [...filteredMedications].sort((a, b) => a.triggerHour - b.triggerHour);
  const isToday = isSameDay(displayDate, simTime);
  const isPast = displayDate < new Date(simTime.toDateString());

  return (
    <div className="flex flex-col h-full bg-slate-50 relative">
      {/* Header with Clock */}
      <div className="bg-white px-6 pt-12 pb-4 shadow-sm z-10 space-y-4">
        <div className="flex justify-between items-start max-w-md mx-auto">
          <div>
            <p className="text-slate-500 font-medium">Good Morning,</p>
            <h1 className={`${headingSize} font-bold text-slate-900 leading-tight`}>{userProfile.name || 'User'}</h1>
          </div>
          <div className="flex gap-2">
            <button 
              onClick={() => setView('add-med')}
              className="p-3 bg-blue-600 rounded-full text-white hover:bg-blue-700 transition shadow-md"
            >
              <Plus size={24} />
            </button>
            <button 
              onClick={() => setView('insights')}
              className="p-3 bg-purple-100 rounded-full text-purple-600 hover:bg-purple-200 transition shadow-sm"
            >
              <PieChart size={24} />
            </button>
            <button 
              onClick={() => setView('settings')}
              className="p-3 bg-slate-100 rounded-full text-slate-600 hover:bg-slate-200 transition"
            >
              <Settings size={24} />
            </button>
          </div>
        </div>

        {/* Calendar Strip */}
        <div className="flex justify-between items-center bg-slate-50 p-2 rounded-xl border border-slate-100">
           {calendarDays.map((date, idx) => {
             const isSelected = isSameDay(date, displayDate);
             return (
               <button 
                 key={idx}
                 onClick={() => setSelectedDate(date)}
                 className={`flex flex-col items-center justify-center w-14 h-16 rounded-xl transition-all ${isSelected ? 'bg-blue-600 text-white shadow-md' : 'text-slate-500 hover:bg-slate-200'}`}
               >
                 <span className="text-xs font-bold uppercase">{getDayName(date, simTime)}</span>
                 <span className={`text-lg font-bold ${isSelected ? 'text-white' : 'text-slate-800'}`}>{date.getDate()}</span>
               </button>
             )
           })}
        </div>
        
        {/* Simulated Clock Display */}
        {medications.length > 0 && isToday && (
          <div className="bg-slate-900 text-white p-3 rounded-xl flex items-center justify-between shadow-inner">
             <div className="flex items-center gap-2">
                <Clock size={18} className="text-blue-400" />
                <span className="text-xs font-bold text-slate-400 uppercase tracking-wider">Simulated Time</span>
             </div>
             <span className="font-mono text-xl font-bold text-blue-300">
               {simTime.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}
             </span>
          </div>
        )}
      </div>

      <div className="flex-1 overflow-y-auto p-6">
        <div className="max-w-md mx-auto space-y-6">
          
          {medications.length === 0 ? (
            /* Empty State */
            <div className="flex flex-col items-center justify-center py-12 text-center space-y-4 opacity-60">
              <div className="bg-slate-200 p-6 rounded-full">
                <Activity size={48} className="text-slate-400" />
              </div>
              <p className={`${textSize} text-slate-500 max-w-xs`}>No medications scheduled. Scan your first bottle to get started.</p>
            </div>
          ) : (
            /* Active Schedule */
            <div className="animate-in fade-in slide-in-from-bottom-4 duration-500">
               {sortedMeds.length === 0 ? (
                  <div className="text-center py-10 bg-white rounded-2xl border border-dashed border-slate-300">
                      <CalendarIcon size={40} className="mx-auto text-slate-300 mb-2"/>
                      <p className="text-slate-500">No medications scheduled for {displayDate.toLocaleDateString()}.</p>
                  </div>
               ) : (
                <div className="bg-emerald-50 p-6 rounded-2xl border border-emerald-100 mb-6">
                  <div className="flex items-center gap-2 mb-4">
                      <Clock className="text-emerald-700" size={20} />
                      <h3 className="font-bold text-emerald-800 text-lg uppercase tracking-wide">
                        {isToday ? "Today's Schedule" : `${displayDate.toLocaleDateString(undefined, {weekday: 'long'})} Schedule`}
                      </h3>
                  </div>
                  
                  {sortedMeds.map((med, idx) => {
                    const dateKey = displayDate.toDateString();
                    let effectiveStatus = 'pending';
                    
                    if (isPast) {
                        effectiveStatus = med.history[dateKey] || 'pending'; 
                    } else if (isToday) {
                        effectiveStatus = med.status;
                    } else {
                        effectiveStatus = 'pending';
                    }

                    return (
                    <div key={idx} className="bg-white p-4 rounded-xl border border-emerald-100 shadow-sm mb-3 relative overflow-hidden">
                      <button 
                        onClick={() => setMedToDelete(med)}
                        className="absolute top-2 right-2 p-2 text-slate-300 hover:text-red-500 transition rounded-full hover:bg-red-50"
                      >
                        <Trash2 size={16} />
                      </button>

                      <div className="flex items-start gap-4 mb-4 pr-8">
                          <div className={`h-12 w-12 rounded-full flex items-center justify-center flex-shrink-0 transition-colors duration-500 ${getStatusColor(effectiveStatus, !isToday && !isPast)}`}>
                              {getStatusIcon(effectiveStatus, !isToday && !isPast)}
                          </div>
                          <div>
                            <p className="font-bold text-xl text-slate-900">{med.name}</p>
                            <div className="flex flex-col">
                              <span className="text-slate-500 font-medium">{med.time} • {med.dosage}</span>
                              <div className="flex flex-wrap gap-2 mt-2">
                                {med.frequency !== 'Daily' && (
                                  <span className="text-xs text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full w-fit border border-blue-100">{med.frequency}</span>
                                )}
                                {med.requiresFood && (
                                  <span className="text-xs font-bold text-white bg-orange-500 px-3 py-1 rounded-full flex items-center gap-1 w-fit shadow-sm">
                                    <Utensils size={12} fill="white" /> Take with Food
                                  </span>
                                )}
                              </div>
                            </div>
                            {isToday && effectiveStatus === 'missed' && <p className="text-xs font-bold text-red-500 uppercase mt-1">Alert Sent</p>}
                          </div>
                      </div>
                      
                      {(isToday || isPast) && effectiveStatus !== 'taken' && (
                        <button 
                            onClick={() => initiateTakeMed(med)}
                            className="w-full py-3 bg-blue-600 text-white text-lg font-bold rounded-xl shadow-md hover:bg-blue-700 active:bg-blue-800 transition transform active:scale-[0.98]"
                        >
                            Mark as Taken
                        </button>
                      )}
                      
                      {effectiveStatus === 'taken' && (
                          <div className="w-full py-2 bg-green-50 text-green-700 font-bold rounded-xl text-center border border-green-100">
                              Taken
                          </div>
                      )}
                    </div>
                  )})}
                </div>
               )}
               
               {isToday && (
                 <p className="text-xs text-center text-slate-400 mt-8">
                   Clock runs 7AM - 7PM. At 7PM it auto-advances to the next day.
