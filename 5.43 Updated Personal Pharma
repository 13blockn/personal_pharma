                 <div className="bg-orange-50 border border-orange-200 rounded-xl p-4">
                    <div className="flex items-center gap-2 text-orange-700 font-bold mb-1">
                      <Clock size={18} />
                      <span>It's Too Early</span>
                    </div>
                    <p className="text-xs text-orange-800 leading-relaxed">
                      Scheduled for <span className="font-bold">{warningModal.med.time}</span> (over 30 mins away). Taking it now might be unsafe.
